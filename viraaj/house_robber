class Solution:
    def rob(self, nums: List[int]) -> int:
        memo = [-1] * len(nums)

        def dfs(i):
            if i >= len(nums):
                return 0
            elif memo[i] != -1:
                return memo[i]
            else:
                rob_current = nums[i] + dfs(i + 2)
                skip_current = dfs(i + 1)

                memo[i] = max(rob_current, skip_current)
            return memo[i]
        
        return dfs(0)
